#!/bin/bash
# 0.3.7: start without a Terminal window. The service runs in the background; the browser opens when ready.
# Stop it with 「시스템 중지」 on the screen. Hold Option while opening the app to see the old Terminal view.
set -e
CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
APP_DATA="$HOME/Library/Application Support/AI Dev Director"
mkdir -p "$APP_DATA"
# Already running: open the screen at once (the full start path waits for the login shell PATH, up to 8 s).
if /usr/bin/curl -fsS -m 1 http://127.0.0.1:8081/health 2>/dev/null | grep -q ai-dev-director-macos; then
    exec /usr/bin/open "http://127.0.0.1:8081/"
fi
if /usr/bin/osascript -l JavaScript -e 'ObjC.import("AppKit"); ($.NSEvent.modifierFlags & $.NSEventModifierFlagOption) ? "1" : ""' 2>/dev/null | grep -q 1; then
    exec /usr/bin/open -a Terminal "$CONTENTS/Resources/start.command"
fi
nohup /bin/bash "$CONTENTS/Resources/start.command" --background >"$APP_DATA/launcher.log" 2>&1 </dev/null &
exit 0
